<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.siyes.training.comprehensive.mapper.OrderMapper">
    <insert
            id="insert"
            parameterType="Order"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO orders (buyer_id, total_amount, status)
        VALUES
            (#{buyerId}, #{totalAmount}, #{status})
    </insert>

    <select id="findById" resultType="Order">
        SELECT * FROM orders
        WHERE
            id = #{id}
    </select>

    <update id="updateStatusById">
        UPDATE orders
        <set>
            status = #{status},
            <if test="cancelledAt != null">
                cancelled_at = #{cancelledAt}
            </if>
        </set>
        WHERE
            id = #{orderId}
        AND status = 'CREATED'
    </update>
</mapper>