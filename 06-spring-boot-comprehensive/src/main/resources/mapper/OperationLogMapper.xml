<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.siyes.training.comprehensive.mapper.OperationLogMapper">
    <insert id="insert">
        INSERT INTO
            operation_logs (order_id, action, detail)
        VALUES
            (#{orderId}, #{action}, #{detail})
    </insert>
</mapper>